<?xml version="1.0"?>
<Plugin>
	<Information>
		<Name>LootTracker</Name>
		<Author>gm</Author>
		<Version>0.2.0</Version>
		<Description>LootTracker

LootTracker is a self/fellowship loot track, it shows all loot items obtained by players.

Commands:
    /lt - Open LootTracker window

More information:

https://github.com/gmichels/LootTracker

</Description>
		<Image>LootTracker/Resources/logo.tga</Image>
	</Information>
	<Package>LootTracker.Main</Package>
	<Configuration Apartment="LootTracker"></Configuration>
</Plugin>